# Copy to .env and fill in values.
# Loaded automatically by devenv (dotenv.enable = true).

# SITE_URL=https://example.com

# Primary LDraw asset base (default: https://catalog.palikkaharrastajat.fi/raw).
VITE_LDRAW_BASE=https://catalog.palikkaharrastajat.fi/raw

# Search and catalog indices base (default: https://catalog.palikkaharrastajat.fi/indices)
# VITE_LDRAW_INDICES_BASE=https://catalog.palikkaharrastajat.fi/indices

# MPD bundles base (default: https://catalog.palikkaharrastajat.fi/bundles)
# VITE_LDRAW_BUNDLES_BASE=https://catalog.palikkaharrastajat.fi/bundles

# Catalog library manifest URL (default: https://catalog.palikkaharrastajat.fi/manifests/library-manifest.json)
# VITE_LDRAW_MANIFEST_URL=https://catalog.palikkaharrastajat.fi/manifests/library-manifest.json

# Optional Vite asset base path (default: ./). Set in CI if you need a different base.
# Example:
# VITE_PUBLIC_BASE=./

# Optional fallback base for missing parts (default: disabled).
# Example:
# VITE_LDRAW_FALLBACK_BASE=https://raw.githubusercontent.com/gkjohnson/ldraw-parts-library/master/complete/ldraw

# Max RPM for motor slider (default: 50).
# VITE_MAX_RPM=50
